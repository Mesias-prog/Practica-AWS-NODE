{
  "name": "mi-node-app",
  "version": "1.1.0",
  "description": "API Express desplegada en AWS EC2 con Nginx y PM2 (Práctica 06 - Patrones de diseño de APIs)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test",
    "deploy:setup": "pm2 deploy ecosystem.config.js production setup",
    "deploy": "pm2 deploy ecosystem.config.js production",
    "deploy:azure:setup": "pm2 deploy ecosystem.config.js azure setup",
    "deploy:azure": "pm2 deploy ecosystem.config.js azure"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mongoose": "^9.11.1",
    "morgan": "^1.10.0",
    "pm2": "^6.0.8"
  }
}
